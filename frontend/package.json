{
  "name": "speech-analytics-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard for Track C - Contrastive Speech Analytics & Temporal Flaw Grounding. Presents backend results only; it computes no analytics.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "samples": "python ../scripts/demo/build_demo_samples.py",
    "shots": "node scripts/screenshots.mjs",
    "a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.0",
    "@fontsource-variable/newsreader": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.11.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.9.0",
    "playwright-core": "^1.56.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
