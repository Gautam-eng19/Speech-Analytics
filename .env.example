# FastAPI & Server
APP_HOST=127.0.0.1
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Pipeline & Contract Versions
CONFIG_VERSION=1.0.0
PIPELINE_VERSION=1.0.0

# Speech Models & AI Providers (DEC-018, DEC-P001, DEC-P008)
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
EXPLANATION_PROVIDER=template

# LLM API Secrets (Optional for P0 - keep blank for template fallback)
GEMINI_API_KEY=

# Storage & Cache Directories (relative to project root)
CACHE_DIR=data/processed/cache
DATA_DIR=data

# Flaw-detection thresholds (PROPOSED, uncalibrated — DEC-P005); defaults live in backend/app/core/config.py
Z_RATE_FAST=2.0
Z_RATE_SLOW=2.0
Z_ENERGY=2.0
Z_PAUSE_WITHIN=2.0
Z_PAUSE_CROSS=2.5
MIN_FLAW_DURATION_S=0.5
MERGE_GAP_S=0.5

# A pause shorter than this is never excessive (DEC-039, 1.2 s since DEC-040); narrowing of window-based rate findings (the fallback, DEC-039)
MIN_PAUSE_FLAW_S=1.2
REFINE_RATE_BOUNDARIES=true
REFINE_MIN_WORDS=8

# Word-by-word comparison with the baseline's reading of the same words (DEC-040; PROPOSED, uncalibrated: choose with evaluate_takes.py --sweep)
PROFILE_ENABLED=true
PROFILE_GAP_CAP_S=0.25
Z_RUN_RATE=4.0
Z_RUN_ENERGY=4.0
RUN_MIN_WORDS=10
MIN_RATE_CHANGE_PCT=15.0
MIN_ENERGY_CHANGE_DB=3.0
GLOBAL_TEMPO_CHANGE_PCT=30.0
PROFILE_MIN_COVERAGE=0.6
PROFILE_MIN_USABLE_WORDS=16
SIGMA_FLOOR_RATE_DRIFT=0.02
SIGMA_FLOOR_RATE_WORD=0.08
SIGMA_FLOOR_LEVEL_DRIFT_DB=0.3
SIGMA_FLOOR_LEVEL_WORD_DB=1.0
SIGMA_FLOOR_TEMPO=0.04
# Flat pitch (DEC-042; PROPOSED, uncalibrated)
PITCH_MIN_VOICED_FRAMES=5
PITCH_DEVIATION_CLIP_ST=6.0
Z_RUN_PITCH=4.5
MIN_FLAT_PITCH_CHANGE_PCT=35.0
GLOBAL_PITCH_CHANGE_PCT=45.0
SIGMA_FLOOR_PITCH_DRIFT=0.05
SIGMA_FLOOR_PITCH_WORD=0.30
SIGMA_FLOOR_PITCH_SCALE=0.08

# Severity (DEC-028, DEC-040; PROPOSED, uncalibrated)
SEVERITY_Z_MIN=1.0
SEVERITY_Z_SEVERE=4.0
SEVERITY_DURATION_SEVERE_S=5.0
SEVERITY_RATE_SEVERE_RATIO=2.0
SEVERITY_ENERGY_SEVERE_DB=15.0
SEVERITY_PAUSE_EXCESS_SEVERE_S=3.5
SEVERITY_PITCH_FLAT_SEVERE_RATIO=3.0

# Scoring (DEC-030; PROPOSED, uncalibrated). Weights of features that cannot be evaluated are redistributed.
BASE_PENALTY=30.0
SCORE_WEIGHT_SPEECH_RATE=0.30
SCORE_WEIGHT_PITCH=0.25
SCORE_WEIGHT_PAUSES=0.25
SCORE_WEIGHT_ENERGY=0.20
SCORE_WEIGHT_MFCC=0.0
SCORE_WEIGHT_CLARITY=0.0

# Pipeline honesty flags and baseline/content checks (DEC-032; PROPOSED, uncalibrated)
THRESHOLDS_CALIBRATED=false
PASSAGE_MATCH_MIN_RATIO=0.6
BASELINE_THIN_RATE_WINDOWS=5
BASELINE_THIN_PAUSES=3

# Dashboard serving (DEC-033)
# Browser origins allowed to call the API (comma-separated). The Vite dev server runs on 5173. Empty = CORS off.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Folder with the built dashboard (npm run build in frontend/); served at "/" when it contains index.html.
FRONTEND_DIST_DIR=frontend/dist
